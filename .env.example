# Base de datos
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=control_total

# Servidor
PORT=3000
NODE_ENV=production

# Auth
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=15d

# CORS — dominios permitidos a llamar a esta API, separados por coma.
# Ej: https://miarepitaquerida.com,https://www.miarepitaquerida.com
# Si se deja vacío, se permite cualquier origen (solo recomendado en desarrollo).
CORS_ORIGINS=

# Página pública (catálogo de productos)
# ID de la empresa que se muestra en la página pública (GET /api/public/*).
# Si se deja vacío, se usa automáticamente la primera empresa activa —
# suficiente mientras solo exista una empresa en la base de datos.
PUBLIC_EMPRESA_ID=
